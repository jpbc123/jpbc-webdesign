# TODO: Set your webhook URL so /get-started leads pipe to WhatsApp/Sheets/Zapier.
# Leads are always saved locally to .data/leads.jsonl; if this is set they are
# also POSTed as JSON to this URL.
LEAD_WEBHOOK_URL=

# Per-market WhatsApp numbers (country code first, digits only, no "+").
# Leave unset and that market falls back to the Malaysian number in
# config/markets/my.ts. Values are read at build time.
PH_WHATSAPP=
AU_WHATSAPP=

# Private client admin (records, payments, receipts). Uses the pvg-store
# Supabase project, isolated in its own `jpbc` schema; see
# supabase/migrations/0001_jpbc_admin.sql. Same URL and anon key as the store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret URL of the admin, e.g. /manage-x7k2p9. Keep it private: it is never
# linked, and /admin itself returns 404. Must not clash with a page or a
# market prefix (/ph, /au).
ADMIN_PATH=
